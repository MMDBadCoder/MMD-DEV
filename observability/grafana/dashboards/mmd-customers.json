{
  "annotations": {
    "list": []
  },
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "tags": [
    "mmd"
  ],
  "description": "Who exists, what they are worth, and who is about to stop.",
  "templating": {
    "list": [
      {
        "name": "username",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mmd-prometheus"
        },
        "query": {
          "query": "label_values(mmd_user_credit_micro_toman, username)",
          "refId": "vars"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "label": "Customer"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "title": "MMD \u00b7 Customers and credit",
  "uid": "mmd-customers",
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Approved",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "sum(mmd_users{status=\"approved\"})",
          "legendFormat": "approved",
          "refId": "A",
          "range": true
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Pending",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "",
