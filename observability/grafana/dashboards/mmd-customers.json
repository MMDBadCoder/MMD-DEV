              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Credit per customer",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "A line crossing zero is a machine about to stop.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "mmd_user_credit_micro_toman{username=~\"$username\"}/1000000",
          "legendFormat": "{{username}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Money moving through the ledger, per hour",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "Toman added or taken in each hour, split by what caused it. `grant` is credit you gave; every `charge_*` is money earned, and shows as a negative number because it leaves the customer's balance. Was 'Ledger movement by kind', which said neither what moved nor over what period.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "sum by (kind) (increase(mmd_ledger_micro_toman[1h]))/1000000",
          "legendFormat": "{{kind}}",
          "refId": "A",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "min",
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "table",
      "title": "Customers closest to running out",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "Balance, lowest first. These are the accounts whose machines stop next.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "bottomk(15, mmd_user_credit_micro_toman{username=~\"$username\"}/1000000)",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "le": true,
              "Value #A": true
            },
            "renameByName": {
              "Value": "Toman",
              "username": "username"
            },
            "indexByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Toman",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "How many ledger rows of each kind exist",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "A running count of transactions by type since the ledger began - not money, just how many times each kind has been written. Useful for spotting a charge type that has stopped happening.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "mmd_ledger_entries",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "le": true,
              "Value #A": true
            },
            "renameByName": {
              "Value": "Rows",
              "kind": "kind"
            },
            "indexByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Rows",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "unit": "short"
        },
        "overrides": []
      }
    },
