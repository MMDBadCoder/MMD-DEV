    {
      "type": "timeseries",
      "title": "Each customer's machine, on or off over time",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "One line per customer: 1 while their machine is meant to be running, 0 while it is off. A snapshot table said only what is true this second; this shows WHEN each machine went up or down, which is the question that leads anywhere. Customers with no machine at all have no line - the chart below counts those.",
      "gridPos": {
        "h": 11,
        "w": 24,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "mmd_workspace_desired_on{username=~\"$username\"}",
