    {
      "type": "timeseries",
      "title": "Where the pool has gone",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "The three-way split the storage tab used to draw as one bar. Stacked, so the bands add up to the pool - and with history, so a band that is growing shows before it matters.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "sum(mmd_workspace_disk_used_mib)/1024",
          "legendFormat": "customer machines",
          "refId": "A",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "mmd_pool_used_gib - sum(mmd_workspace_disk_used_mib)/1024",
          "legendFormat": "platform: images, snapshots, overhead",
          "refId": "B",
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "mmd_pool_free_gib",
          "legendFormat": "free",
          "refId": "C",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "normal"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
