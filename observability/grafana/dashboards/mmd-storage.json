  "description": "Where the pool has gone and how far it is overcommitted.",
  "templating": {
    "list": [
      {
        "name": "username",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mmd-prometheus"
        },
        "query": {
          "query": "label_values(mmd_user_credit_micro_toman, username)",
          "refId": "vars"
        },
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "label": "Customer"
      }
    ]
  },
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "title": "MMD \u00b7 Storage and capacity",
