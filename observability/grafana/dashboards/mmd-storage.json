    {
      "type": "stat",
      "title": "Overcommit",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "Disk promised to customers divided by disk that exists. Above 1 is deliberate - that is thin provisioning - and stays safe while real usage sits well under the pool.",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "mmd_pool_committed_gib / mmd_pool_total_gib",
          "legendFormat": "x",
          "refId": "A",
          "range": true
