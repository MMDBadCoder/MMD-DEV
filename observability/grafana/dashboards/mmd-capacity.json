    {
      "type": "table",
      "title": "How old is each machine's last reading?",
      "datasource": {
        "type": "prometheus",
        "uid": "mmd-prometheus"
      },
      "description": "Usage is only measured while a machine runs, so a switched-off machine's reading ages forever - a large number here usually just means 'off'. It matters for machines you believe are ON: there, a growing age means metering has stopped and that customer is not being billed. Was called 'Stale samples'.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "mmd-prometheus"
          },
          "expr": "topk(10, mmd_workspace_sample_age_seconds{username=~\"$username\"})",
          "legendFormat": "",
          "refId": "A",
          "range": false,
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "le": true,
              "Value #A": true
            },
            "renameByName": {
              "Value": "Seconds ago",
              "username": "username"
            },
            "indexByName": {}
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Seconds ago",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          },
          "unit": "s",
          "decimals": 0
        },
        "overrides": []
      }
    }
