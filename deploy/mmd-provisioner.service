[Unit]
Description=MMD-DEV workspace provisioner (privileged)
After=incus.service
Requires=incus.service

[Service]
Type=simple
# Root is unavoidable here: creating Incus projects and instances requires
# admin on the Incus API. Everything else about this unit exists to make that
# root as narrow as possible.
User=root
# Group=mmd so systemd creates /run/mmd as root:mmd - the API (running as mmd)
# must be able to traverse the directory to reach the socket. systemd takes
# runtime-directory ownership from User=/Group=; there is no separate
# RuntimeDirectoryGroup= directive.
Group=mmd
# The Incus CLI insists on creating a config directory under $HOME. With
# ProtectHome=yes that is a read-only path and every incus command fails with
# "mkdir /root/.config: read-only file system" - which surfaces as a confusing
# "golden image not found". Point it at the (writable) runtime directory
# instead of giving up ProtectHome.
Environment=INCUS_CONF=/run/mmd/incus-conf

# --- the platform's Claude Code sign-in ------------------------------------
# Workspaces ship with Claude Code already signed in, so the provisioner has to
# read the operator's OAuth grant. ProtectHome=yes hides /root entirely, which
# is the correct default - so rather than relax it, one directory is bound back
# in READ-ONLY at a path that exists only for this purpose. The provisioner can
# therefore never write to the operator's home, and nothing else under /root is
# visible to it at all.
#
# The whole ~/.claude directory rather than the single credentials file: Claude
# Code rewrites credentials atomically (new file, then rename), and a bind mount
# of a *file* would keep pointing at the replaced inode and serve an expired
# token forever. What may be read out of it is narrowed in code instead - see
# CLAUDE_AUTH_FILE in provisioner.py, and tests/test_claude_auth.py, which
# asserts that exactly one filename is ever opened.
#
# Change both lines together if the operator account is not root.
BindReadOnlyPaths=/root/.claude:/var/lib/mmd/host-claude/.claude
Environment=MMD_CLAUDE_HOST_HOME=/var/lib/mmd/host-claude

ExecStart=/usr/bin/python3 /opt/mmd/control/provisioner/provisioner.py
Restart=on-failure
RestartSec=3

RuntimeDirectory=mmd
RuntimeDirectoryMode=0750

# No network at all. The provisioner speaks only over its unix socket, so it
# cannot be reached from the dashboard's port, from a workspace, or from the
# internet even if something in it were exploitable.
PrivateNetwork=no
IPAddressDeny=any

NoNewPrivileges=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelTunables=yes
ProtectControlGroups=no
PrivateTmp=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=no
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
