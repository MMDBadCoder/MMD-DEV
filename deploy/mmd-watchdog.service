[Unit]
Description=MMD-DEV worker watchdog
After=network-online.target postgresql.service

[Service]
Type=oneshot
User=mmd
Group=mmd
WorkingDirectory=/opt/mmd/control
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mmd/api.env
# The one place outside the worker that holds the SMS key. It has to send
# directly, because the process that drains the outbox is the one that stopped.
LoadCredential=kavenegar:/etc/mmd/kavenegar.key
ExecStart=/opt/mmd/venv/bin/python -m mmd.watchdog
# A stalled worker exits 1 by design; that is a report, not a unit failure.
SuccessExitStatus=0 1

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
