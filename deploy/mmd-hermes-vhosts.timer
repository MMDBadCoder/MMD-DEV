[Unit]
Description=Reconcile Hermes dashboard vhosts

[Timer]
# Two minutes: a customer enabling Hermes waits for the worker to mint a key
# and then for this to publish the address. Slower would read as broken; faster
# would mean running certbot's retry logic more often than it can make progress.
OnBootSec=90s
OnUnitActiveSec=2min
AccuracySec=15s

[Install]
WantedBy=timers.target
