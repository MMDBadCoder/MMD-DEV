[Unit]
Description=MMD-DEV billing and lifecycle worker
After=network-online.target postgresql.service incus.service mmd-api.service
Wants=postgresql.service

[Service]
Type=simple
# Holds a METRICS-type Incus certificate (read-only, /1.0/metrics only) plus
# the restricted client cert for stopping workspaces that run out of credit.
User=mmd
Group=mmd
WorkingDirectory=/opt/mmd/control
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/mmd/api.env
# The OpenRouter management key, which can mint keys that spend real money.
#
# LoadCredential rather than an EnvironmentFile because mmd-api runs as the SAME
# user: any file mode that lets the worker read it lets the web app read it too.
# systemd puts this in a per-unit tmpfs inside this unit's mount namespace, so
# the internet-facing process cannot see it at all - not merely "should not".
# Missing file = Hermes stays unprovisioned; it is not fatal to billing.
LoadCredential=openrouter:/etc/mmd/openrouter.key
# The SMS provider key, worker-only for the same reason.
LoadCredential=kavenegar:/etc/mmd/kavenegar.key
ExecStart=/opt/mmd/venv/bin/python -m mmd.worker
Restart=on-failure
RestartSec=5

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/mmd
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
